# Copia este archivo a .env y rellénalo. .env está en .gitignore: no lo subas nunca.
SUPABASE_URL=https://<proyecto>.supabase.co
# Clave service_role (Supabase → Project Settings → API). Da acceso total: solo en local.
SUPABASE_SERVICE_ROLE_KEY=
# Opcionales
SUPABASE_GPX_BUCKET=race-tracks
SUPABASE_TARGET_TABLE=race_tracks_duplicate
